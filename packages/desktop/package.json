  "scripts": {
    "typecheck": "tsgo -b",
    "test": "node --import tsx --import ../../packages/test-shim/register.mjs --test \"src/**/*.test.ts\" \"tests/*.test.ts\" \"electron-builder.config.test.ts\" \"electron-builder.resources.test.ts\" \"gateway-update/*.test.ts\"",
    "predev": "node --import tsx ./scripts/predev.ts",
    "dev": "electron-vite dev",
    "prebuild": "node --import tsx ./scripts/prebuild.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "node --import tsx ./scripts/stage-gateway.ts && electron-builder --config electron-builder.config.ts",
    "package:mac": "node --import tsx ./scripts/stage-gateway.ts && electron-builder --mac --config electron-builder.config.ts",
    "package:win": "node --import tsx ./scripts/stage-gateway.ts && electron-builder --win --config electron-builder.config.ts",
    "package:linux": "node --import tsx ./scripts/stage-gateway.ts && electron-builder --linux --config electron-builder.config.ts",
    "native:build": "npm install --prefix native"
  },
  "main": "./out/main/index.js",

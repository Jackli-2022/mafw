{
  "name": "@mafw/sdk",
  "version": "5.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "npm run gen:api && tsc",
    "gen:api": "node scripts/merge-contract.mjs && openapi-typescript contract/openapi.json -o src/api-schema.gen.ts",
    "gen:opencode-ref": "node --import tsx scripts/gen-opencode-reference.ts",
    "emit:view-dto": "node --import tsx scripts/emit-view-dto.ts",
    "test": "node --import tsx --require ../../packages/test-shim/require-hook.cjs --test \"src/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.probes.json"
  },
  "dependencies": {
    "@mafw/plugin-contract": "*"
  },
  "devDependencies": {
    "@mafw/test-shim": "*",
    "openapi-typescript": "^7.13.0",
    "tsx": "4.20.3",
    "typescript": "^5.3.0"
  }
}

      "post": { "operationId": "goals.control", "tags": ["goals"], "description": "Goal control (PAUSE/ABORT/FORCE_PHASE/RESET_PARAMETRIC). Gateway also accepts legacy POST /control (MCP handler compat) — same handler.", "responses": { "200": { "description": "Accepted" } } }

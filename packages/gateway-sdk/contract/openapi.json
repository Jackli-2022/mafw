      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": { "operationId": "session.get", "tags": ["session"], "responses": { "200": { "description": "Session" }, "404": { "description": "Not found" } } },
      "delete": { "operationId": "session.delete", "tags": ["session"], "responses": { "200": { "description": "Deleted" } } },
      "patch": { "operationId": "session.rename", "tags": ["session"], "responses": { "200": { "description": "Renamed" } } }
    },
    "/api/sessions/{id}/messages": {

      "post": { "operationId": "goals.respondQuestion", "tags": ["goals"], "description": "Goal-scoped question reply (desktop QuestionWidget). Distinct from /api/questions/{id}/reply (native opencode question API).", "responses": { "200": { "description": "Answered" } } }

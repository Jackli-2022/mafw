{
  "openapi": "3.1.0",
  "info": {
    "title": "MAFW Gateway API — SDK-facing contract",
    "version": "1.0.0",
    "description": "Single source of truth for every endpoint @mafw/sdk may call. Covers the MafwClient namespaces, SSE event stream, A2A media agent, and TTS streaming. Drift is enforced by tests on both sides: gateway-sdk/src/contract.test.ts (SDK calls ⊆ contract) and gateway/tests/unit/api-contract.test.ts (contract ⊆ gateway routes). Path parameters are normalized to {} in drift comparisons. Adding an SDK method requires adding its operation here FIRST (SDK drift test fails otherwise); removing/changing a gateway route requires updating this file (gateway drift test fails otherwise)."
  },
  "paths": {
    "/api/session": {
      "post": { "operationId": "session.create", "tags": ["session"], "responses": { "200": { "description": "Created session" } } }
    },
    "/api/sessions": {
      "get": { "operationId": "session.list", "tags": ["session"], "responses": { "200": { "description": "Session list" } } }
    },

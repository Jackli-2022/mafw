{
  "$comment": "P4-B 手写响应 schema 覆盖层，按 operationId keyed；merge-contract 时注入 openapi.json 的 responses.200.content['application/json'].schema",
  "operations": {
    "session.list": {
      "responseSchema": {
        "type": "object",
        "properties": {
          "sessions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "projectID": {
                  "type": "string"
                },
                "directory": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "time": {
                  "type": "object",
                  "properties": {
                    "created": {
                      "type": "number"
                    },
                    "updated": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "created",
                    "updated"
                  ]
                },
                "parentID": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "projectID",
                "directory",
                "title",
                "time"
              ]
            }
          }
        },
        "required": [
          "sessions"
        ]
      }
    },

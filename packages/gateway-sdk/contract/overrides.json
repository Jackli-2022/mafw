{
  "$comment": "P4-B hand-written response schema overlay, keyed by operationId; merge-contract injects it into openapi.json responses.200.content['application/json'].schema. Catalog code-first schemas win at merge time (merge-contract.mjs prints \"catalog response schema wins over overrides\"). goals.list / goals.sessions (E10b-1) and approvals.list / questions.list / triage.list (E10b-2) are code-first now, so their entries were deleted (18 -> 13).",
  "operations": {
    "session.list": {
      "responseSchema": {
        "type": "object",
        "properties": {
          "sessions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "projectID": {
                  "type": "string"
                },
                "directory": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "time": {
                  "type": "object",
                  "properties": {
                    "created": {
                      "type": "number"
                    },
                    "updated": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "created",
                    "updated"
                  ]
                },
                "parentID": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "idle",
                    "busy",
                    "retry",
                    "unknown"
                  ]
                },
                "reverted": {
                  "type": "object",
                  "properties": {
                    "messageID": {
                      "type": "string"
                    },
                    "partID": {
                      "type": "string"
                    },
                    "diffs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "file": {
                            "type": "string"
                          },
                          "patch": {
                            "type": "string"
                          },
                          "additions": {
                            "type": "number"
                          },
                          "deletions": {
                            "type": "number"
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "added",
                              "modified",
                              "deleted",
                              "renamed",
                              "unknown"
                            ]
                          }
                        },
                        "required": [
                          "file"
                        ]
                      }
                    }
                  },
                  "required": [
                    "messageID"
                  ]
                },
                "model": {
                  "type": "object",
                  "properties": {
                    "providerID": {
                      "type": "string"
                    },
                    "modelID": {
                      "type": "string"
                    },
                    "variant": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "providerID",
                    "modelID"
                  ]
                },
                "agent": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "projectID",
                "directory",
                "title",
                "time"
              ]
            }
          }
        },
        "required": [
          "sessions"
        ]
      }
    },
    "session.messages": {
      "description": "Session history as MAFW View DTO (flat MafwMessage: {id,role,content,...}). The legacy {info,parts} envelope and the format opt-in were removed in Task 15."
    },
    "memory.search": {
      "responseSchema": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "episodic",
                    "semantic",
                    "procedural",
                    "global"
                  ]
                },
                "primary_abstraction": {
                  "type": "string"
                },
                "cue_anchors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "memory_value": {
                  "type": "string"
                },
                "energy": {
                  "type": "number"
                },
                "salience": {
                  "type": "number"
                },
                "created_at": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "type",
                "primary_abstraction",
                "cue_anchors",
                "memory_value",
                "energy"
              ]
            }
          }
        },
        "required": [
          "results"
        ]
      }
    },
    "automations.list": {
      "responseSchema": {
        "type": "object",
        "properties": {
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                },
                "name": {
                  "type": "string"
                },
                "trigger": {
                  "type": "object",
                  "properties": {
                    "schedule": {
                      "type": "string"
                    },
                    "timezone": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "schedule",
                    "timezone"
                  ]
                },
                "action": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type"
                  ]
                }
              },
              "required": [
                "id",
                "enabled"
              ]
            }
          }
        },
        "required": [
          "rules"
        ]
      }
    },
    "triage.dismiss": {
      "summary": "Dismiss triage item",
      "description": "Dismiss = reject alias (state REJECTED), ledger reason triage_dismissed. Route added 2026-09-17 fixing SDK drift bug."
    },
    "goals.control": {
      "summary": "Goal control",
      "description": "PAUSE/ABORT/FORCE_PHASE/RESET_PARAMETRIC. Gateway also accepts legacy POST /control (MCP handler compat) - same handler."
    },
    "event.subscribe": {
      "summary": "SSE event stream",
      "description": "?sessionID= scopes to a session. SDK helper events.url() returns this URL for renderer-direct EventSource (contract in SDK, transport direct)."
    },
    "tts.speakStream": {
      "summary": "Streaming TTS",
      "description": "SSE of base64 PCM16 chunks (24kHz mono). SDK helper tts.streamUrl() returns this URL; transport stays renderer-direct (IPC cannot clone the SSE stream)."
    },
    "media.upload": {
      "summary": "Binary media upload",
      "description": "Raw octet-stream, ?type=. Must go through Node network stack (Chromium fetch hangs behind system proxies). SDK helper media.upload()."
    },
    "media.uploadAndCreate": {
      "summary": "Upload + A2A task create in one round-trip",
      "description": "?type=&question=. SDK helper media.uploadAndCreate()."
    },
    "media.artifact": {
      "summary": "Artifact bytes",
      "description": "TTS audio / uploaded media. Consumed directly by <audio src> via SDK media.artifactUrl() helper - transport stays direct."
    },
    "project.setCurrent": {
      "summary": "Register current project",
      "description": "Real register route persists the registry and broadcasts project_registered."
    },
    "goals.respondQuestion": {
      "summary": "Goal-scoped question reply",
      "description": "Desktop QuestionWidget. Distinct from /api/questions/{id}/reply (native opencode question API)."
    }
  }
}

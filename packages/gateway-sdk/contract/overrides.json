    "questions.list": {
      "responseSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "sessionID": {
                  "type": "string"
                },
                "questions": {
                  "type": "array",
                  "items": {

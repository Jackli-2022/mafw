{
  "name": "mafw-desktop",
  "version": "1.0.0",
  "description": "MAFW Desktop — Electron shell for Gateway",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.mafw.desktop",
    "productName": "MAFW Desktop",
    "extraResources": [
      {
        "from": "../gateway/dist",
        "to": "gateway",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "**/*",
      "!node_modules/**/node_modules"
    ]
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^24.9.1"
  }
}

// Narrow *type* gate for a deliberately small slice of the gateway test tree.
//
// The full test tree still carries a large pre-existing type-error backlog, so
// this config is not `tests/tsconfig.json` under `--noEmit`. It covers only the
// suites that were written against typed contracts (the adapter build/host-seam
// and packaging tests plus their helpers), which keeps the gate honest without
// loosening `strict`. Widening `include` is the backlog burn-down, not a fix.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["jest", "node"]
  },
  "include": [
    "tests/helpers/**/*.ts",
    "tests/unit/runtime/adapter-build.test.ts",
    "tests/unit/runtime/host-seam-propagation.test.ts",
    "tests/unit/runtime/opencode-package.test.ts",
    "tests/integration/plugin-package-e2e.test.ts"
  ]
}

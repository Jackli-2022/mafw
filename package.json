{
  "name": "opencode-plugin-mafw",
  "version": "4.1.0",
  "description": "MAFW Loop Agent Plugin for OpenCode — Phase Relay + TMEM + Dynamic Compression",
  "main": "dist/plugin.js",
  "opencode": {
    "plugin": "dist/plugin.js"
  },
  "bin": {
    "mafw": "./bin/mafw.js"
  },
  "scripts": {
    "build": "tsc && cd gateway && npm run build",
    "postinstall": "node -e \"var p=require('path'),f=require('fs'),d=p.join(__dirname,'gateway');if(f.existsSync(d)){require('child_process').execSync('npm install --omit=dev --no-audit --no-fund --loglevel=error',{cwd:d,stdio:'inherit'})}\"",
    "prepare": "npm run build",
    "pack:install": "npm run build && npm pack && npm install -g opencode-plugin-mafw-*.tgz && mafw version",
    "test": "jest",
    "test:unit": "jest tests/unit"
  },
  "files": [
    "dist/",
    "gateway/dist/",
    "gateway/package.json",
    ".opencode/",
    "bin/",
    "README.md"
  ],
  "dependencies": {
    "@a2a-js/sdk": "^1.0.1",
    "@huggingface/transformers": "^4.2.0",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.4.7",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opencode-ai/sdk": "^1.17.12",
    "axios": "^1.6.0",
    "better-sqlite3": "^12.11.1",
    "bonjour-service": "^1.4.4",
    "cron": "^3.1.7",
    "js-yaml": "^4.1.0",
    "langchain-mcp-adapters": "^0.6.0",
    "opencode-ai": "^1.0.0",
    "simple-git": "^3.20.0",
    "ws": "^8.21.3",
    "zeromq": "^6.1.2",
    "zod": "^3.25.32"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.0",
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

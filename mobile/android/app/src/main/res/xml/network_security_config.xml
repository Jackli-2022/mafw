<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- I2 hardening: global cleartext disabled. Cleartext is allowlisted ONLY
         for the ts.net domain tree (MagicDNS). `includeSubdomains="true"` is
         required: without it Android matches the exact host `ts.net` only, so
         `machine.<tailnet>.ts.net` would fall back to the base-config and be
         blocked. This config governs the platform native network stack (media
         playback such as TTS via just_audio/ExoPlayer); Dart/package:http
         traffic is not NSC-bound and is gated by app-level UrlCheck instead. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">ts.net</domain>
    </domain-config>
</network-security-config>
